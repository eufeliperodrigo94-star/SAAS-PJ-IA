# Copie para .env e preencha com os valores do seu projeto Supabase.

ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:8080

SUPABASE_URL=
# service_role key — apenas no backend, NUNCA no frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# anon/publishable key — usada pelo frontend (Supabase JS).
SUPABASE_ANON_KEY=

ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-5
